APP_NAME="BookStore"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.up.railway.app

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Configuration (MySQL for Production - Railway / PlanetScale / Aiven)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bookstore
DB_USERNAME=root
DB_PASSWORD=

# Sessions & Cache (Database backed for persistence across restarts)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_DRIVER=database
QUEUE_CONNECTION=sync

# Filesystem / Media Storage
# For local or Railway persistent volume, use 'public' and run 'php artisan storage:link'
# For Cloudflare R2 / S3 free tier (10GB free), set FILESYSTEM_DISK=s3
FILESYSTEM_DISK=public
MEDIA_DISK=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=bookstore-images
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Stripe Payment Processing (from dashboard.stripe.com)
STRIPE_KEY=pk_test_...
STRIPE_SECRET=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email Configuration (Resend free tier: 3,000 emails/month or Mailgun/SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=re_...
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="orders@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Initial Administrator Provisioning (Optional override for production seed)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=

# Docker auto-run migrations flag (optional)
AUTORUN_MIGRATIONS=true
